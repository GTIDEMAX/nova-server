# Copia este archivo como .env (o exporta las variables) y rellena lo que tengas.

# --- IA de texto (obligatorio para textos reales; sin esto funciona en modo demo) ---
ANTHROPIC_API_KEY=

# --- IA de imagenes (opcional; sin esto el agente no genera imagenes) ---
# Clave de OpenAI para generar imagenes con gpt-image-1
IMAGE_API_KEY=

# URL publica de tu app (para publicar imagenes generadas en redes desde el programador)
# Ej: https://agente-social-2q0l.onrender.com
PUBLIC_BASE_URL=

# --- Puerto del servidor (opcional) ---
PORT=4000

# --- Redes sociales (opcional; sin esto se publica en modo simulado) ---
# Meta (Instagram + Facebook) — YA IMPLEMENTADO
META_ACCESS_TOKEN=
# Id de tu pagina de Facebook (para publicar en Facebook)
META_PAGE_ID=
# Id de tu cuenta de Instagram Business (para publicar en Instagram)
META_IG_USER_ID=
# LinkedIn
LINKEDIN_ACCESS_TOKEN=
# TikTok
TIKTOK_ACCESS_TOKEN=
# Web / blog (URL a la que se hace POST con la publicacion)
WEB_PUBLISH_WEBHOOK=

# --- WhatsApp Cloud API (opcional; sin esto se envia/recibe en modo simulado) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Token que tu eliges para verificar el webhook (debe coincidir con el que pones en Meta)
WHATSAPP_VERIFY_TOKEN=agente-social

# --- Base de datos (MUY recomendado en Render: sin esto se borran los datos al reiniciar) ---
# Cadena de conexion de MongoDB Atlas (plan gratis). Ej: mongodb+srv://usuario:clave@cluster0.xxxx.mongodb.net
MONGODB_URI=
# Nombre de la base (opcional)
MONGODB_DB=agente_social

# --- Recordatorios de bateria (pestana Clientes) ---
# Sin esto funcionan en modo 1-TOQUE (el panel te muestra a quien le toca y lo mandas con un toque).
# Para que se envien SOLOS: WhatsApp Cloud API + plantilla aprobada por Meta + RECORDATORIOS_AUTO=1
RECORDATORIOS_AUTO=0
# Nombre exacto de la plantilla aprobada en Meta (cuerpo con 3 variables: nombre, negocio, consejo)
WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_bateria
WHATSAPP_TEMPLATE_IDIOMA=es_MX

# --- Bot de WhatsApp externo (manda los recordatorios solo, espaciados). Ver BOT.md ---
# Clave larga que inventes; la misma va en tu bot.
BOT_TOKEN=
# Envio espaciado (bot y automatico)
RECORDATORIOS_HORA_INICIO=10
RECORDATORIOS_HORA_FIN=19
RECORDATORIOS_MIN_ESPERA_MIN=4
RECORDATORIOS_MAX_ESPERA_MIN=10
RECORDATORIOS_MAX_DIA=25
RECORDATORIOS_ZONA=America/Mexico_City
