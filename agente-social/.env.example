# Copia este archivo como .env (o exporta las variables) y rellena lo que tengas.

# --- IA (obligatorio para textos reales; sin esto funciona en modo demo) ---
ANTHROPIC_API_KEY=

# --- Puerto del servidor (opcional) ---
PORT=4000

# --- Redes sociales (opcional; sin esto se publica en modo simulado) ---
# Meta (Instagram + Facebook)
META_ACCESS_TOKEN=
# LinkedIn
LINKEDIN_ACCESS_TOKEN=
# TikTok
TIKTOK_ACCESS_TOKEN=
# Web / blog (URL a la que se hace POST con la publicacion)
WEB_PUBLISH_WEBHOOK=

# --- WhatsApp Cloud API (opcional; sin esto se envia en modo simulado) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
